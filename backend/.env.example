NODE_ENV=development
PORT=8080

# Supabase backend access. The backend uses the service role key for table
# reads/writes and a client key only to validate Supabase Auth bearer tokens.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>
# Legacy fallback supported by backend/lib/supabase-admin.js:
# SUPABASE_SERVICE_KEY=<legacy-service-role-key>
# Optional Supabase client-key aliases:
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# SUPABASE_PUBLISHABLE=<publishable-key>

# Optional. If absent, scans use unauthenticated PageSpeed requests and can
# fall back to the lightweight HTML estimate path.
PAGESPEED_API_KEY=
DEBUG_TTL_ZERO=false

# Optional result report email delivery.
# If SENDGRID_API_KEY is set, /api/check-carbon can email the scan result link
# (when public email + consent are captured).
SENDGRID_API_KEY=
REPORT_FROM_EMAIL=
REPORT_EMAIL_ENABLED=true

# Public URLs used for generated report, badge, and redirect links.
SITE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080

# Admin-only licence maintenance endpoint.
LICENSE_ADMIN_KEY=<local-admin-key>

# Stripe is optional for local non-Stripe flows. Missing values make Stripe
# checkout/webhook endpoints return 503, but scans, public badges, and dashboard
# reads still run when Supabase is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_MODE=subscription
STRIPE_PRICE_ID_VERIFIED_BADGE=
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_STARTER_YEARLY=
STRIPE_PRICE_ID_AGENCY_MONTHLY=
STRIPE_PRICE_ID_AGENCY_YEARLY=
